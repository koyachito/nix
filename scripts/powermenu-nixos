#!/usr/bin/env bash
set -euo pipefail

choice=$(printf ' Lock\n󰒲 Suspend\n󰜉 Reboot\n Shutdown\n Logout\n' \
    | fuzzel --dmenu --prompt='Power > ')

case "$choice" in
    ' Lock') swaylock -f ;;
    '󰒲 Suspend') swaylock -f && systemctl suspend ;;
    '󰜉 Reboot') systemctl reboot ;;
    ' Shutdown') systemctl poweroff ;;
    ' Logout') swaymsg exit ;;
esac
