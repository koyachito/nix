// NixOS niri port of config/sway/config-nixos (お試し用ベースライン)
// Swayのキーバインドを可能な限り踏襲。niriに概念がないもの:
//   - scratchpad (Mod+Minus) → 列幅調整に転用
//   - split/stacking/tabbed → 列(column)操作 + tabbed column に対応
// 設定は保存時に自動リロードされる (Mod+Shift+C 相当は不要)。

input {
    keyboard {
        xkb {
            layout "us"
        }
        repeat-delay 300
        repeat-rate 25
    }
    touchpad {
        natural-scroll
    }
    // focus-follows-mouse はデフォルトで無効 (sway: focus_follows_mouse no)
}

// Display layout: laptop left, HDMI right
output "eDP-1" {
    position x=0 y=0
    scale 1.25
}
output "HDMI-A-1" {
    position x=1536 y=0
    scale 1.75
}

layout {
    gaps 8
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }
    focus-ring {
        width 2
    }
}

prefer-no-csd

screenshot-path "~/Pictures/ScreenShots/%Y-%m-%d_%H-%M-%S.png"

// Animated GIF wallpaper (sway config と同じ awww watchdog)
spawn-sh-at-startup "rm -f \"$XDG_RUNTIME_DIR\"/wayland-*-awww-daemon.sock 2>/dev/null; exec awww-daemon"
spawn-sh-at-startup "tries=0; until awww query >/dev/null 2>&1; do tries=$((tries + 1)); if [ \"$tries\" -ge 25 ]; then awww-daemon >/dev/null 2>&1 & disown; tries=0; fi; sleep 0.2; done; awww img \"$HOME/Pictures/Wallpapers/wallpaper.gif\""

// Session daemons (dbus環境変数の取り込みは niri-session がやってくれる)
spawn-at-startup "mako"
spawn-at-startup "fcitx5" "-d"
spawn-at-startup "nm-applet" "--indicator"
spawn-sh-at-startup "swayidle -w timeout 900 '$HOME/.local/bin/undertale-lock' timeout 1800 'systemctl suspend' before-sleep '$HOME/.local/bin/undertale-lock'"

binds {
    // Mod+Shift+/ でキーバインド一覧 (niri組み込み)
    Mod+Shift+Slash { show-hotkey-overlay; }

    Mod+Return { spawn "kitty"; }
    Mod+D { spawn "fuzzel"; }
    Mod+Space { spawn "flatpak" "run" "org.mozilla.firefox"; }
    Mod+Y { spawn "kitty" "-e" "yazi"; }
    Mod+Ctrl+L { spawn-sh "$HOME/.local/bin/undertale-lock"; }
    Mod+X { spawn-sh "$HOME/.local/bin/powermenu"; }
    Mod+Q { close-window; }
    Mod+Shift+E { quit; }

    Mod+H { focus-column-left; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }
    Mod+L { focus-column-right; }
    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }
    // 矢印上下はワークスペース切り替え (niriはWSが縦に並ぶ)
    Mod+Down { focus-workspace-down; }
    Mod+Up { focus-workspace-up; }

    Mod+Shift+H { move-column-left; }
    Mod+Shift+J { move-window-down; }
    Mod+Shift+K { move-window-up; }
    Mod+Shift+L { move-column-right; }
    Mod+Shift+Left { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    // Shift+矢印上下でウィンドウを上下のWSへ飛ばす(フォーカスも追従)
    Mod+Shift+Down { move-window-to-workspace-down; }
    Mod+Shift+Up { move-window-to-workspace-up; }

    // モニタ間移動: フォーカス / 列ごと投げる
    Mod+Ctrl+Left { focus-monitor-left; }
    Mod+Ctrl+Right { focus-monitor-right; }
    Mod+Ctrl+Shift+Left { move-column-to-monitor-left; }
    Mod+Ctrl+Shift+Right { move-column-to-monitor-right; }

    // 列(column)操作: 隣のウィンドウを自列に取り込む / 自列から追い出す
    Mod+Comma { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }
    Mod+W { toggle-column-tabbed-display; }

    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+C { center-column; }
    Mod+Shift+Space { toggle-window-floating; }

    // sway の resize mode の代わり
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-window-height; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    // 全ワークスペース俯瞰 (niriの売りのひとつ)
    Mod+O { toggle-overview; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+0 { focus-workspace 10; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }
    Mod+Shift+0 { move-column-to-workspace 10; }

    // スクリーンショットは niri 組み込みUI (grim+slurp 不要)
    Print { screenshot; }
    Shift+Print { screenshot-screen; }
    Ctrl+Print { screenshot-window; }

    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "brightnessctl" "set" "+5%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "set" "5%-"; }
}
